# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Admin numerical ID (get it from @userinfobot)
ADMIN_ID=123456789

# Main channel numerical ID (e.g. -1001234567890)
MAIN_CHANNEL_ID=-1001234567890

# Post destination channel ID (where post photo and link button are published)
POST_CHANNEL_ID=-1001234567890

# Storage channel ID for big video uploads (optional, defaults to MAIN_CHANNEL_ID)
STORAGE_CHANNEL_ID=-1001234567890

# Telegram API credentials from https://my.telegram.org (for GramJS 2GB uploads)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Video display duration in seconds (default: 30)
VIDEO_DELETE_DELAY=30

# Maximum daily downloads per user (0 = unlimited)
DAILY_LIMIT=0

